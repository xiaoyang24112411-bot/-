# NoneBot 服务端配置
HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi
LOG_LEVEL=INFO
COMMAND_START=["/"]

# 若协议端配置了 Access Token，这里必须填写相同的值。
# 本机首次调试可以两端都留空；公网/局域网监听时务必使用强随机 Token。
ONEBOT_ACCESS_TOKEN=

# 群管理：默认关闭自动撤回，确认机器人有管理员权限后再开启。
ENABLE_SENSITIVE_RECALL=false
SENSITIVE_WORDS=广告
# 全局机器人管理员 QQ 号；支持英文逗号、中文逗号或空格分隔。
BOT_ADMIN_IDS=2448821316

# 群聊早安/晚安：纯本地随机文案，不调用 AI；默认全天、所有群启用。
# 群列表留空表示所有群；填写群号后仅这些群启用。多个 ID 用逗号或空格分隔。
GREETING_ENABLED=true
GREETING_GROUP_IDS=
# OneBot 无法可靠识别所有第三方机器人，可在此填写需要忽略的机器人 QQ 号。
GREETING_IGNORED_USER_IDS=
# 默认取消所有问候冷却；如日后需要限频，可填正整数秒数。
GREETING_USER_COOLDOWN_SECONDS=0
GREETING_GROUP_COOLDOWN_SECONDS=0
# 可选自定义：JSON 字符串数组，替换对应默认列表；留空则使用内置值。
# GREETING_MORNING_WORDS='["早安", "早上好", "早晨好"]'
# GREETING_NIGHT_WORDS='["晚安", "晚上好"]'
# GREETING_MORNING_REPLIES='["早安！祝你今天开心 ☀️", "早上好，记得吃早餐！"]'
# GREETING_NIGHT_REPLIES='["晚安，做个好梦 🌙", "辛苦啦，好好休息！"]'

# DeepSeek API（密钥仅填写在本机 .env.prod，不要提交到 Git）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEEP_MAX_OUTPUT_TOKENS=4096
# 可选：仅 /联网问 和 /深度联网问 使用。需自行申请 Brave Search API Key。
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=20
# DeepSeek 官方峰价时段暂停 @自动回答和主动插话；/问 等人工指令不受影响。
DEEPSEEK_SUSPEND_AUTOCHAT_DURING_PEAK=true

# 小鲸鱼自主回答：默认按群关闭，仅 QQ 2448821316 可通过群内指令开关。
# 不限制每日次数，也不设置冷却；峰价保护、夜间静默和概率触发仍生效。
AUTO_CHAT_MIN_MESSAGES=6
AUTO_CHAT_CONTEXT_MESSAGES=12
AUTO_CHAT_CONTEXT_TTL_SECONDS=1200
AUTO_CHAT_TRIGGER_PERCENT=80
AUTO_CHAT_QUIET_START_HOUR=0
AUTO_CHAT_QUIET_END_HOUR=7

# 头像表情包：同时支持“摸摸”和“/摸摸”等形式。
PETPET_COMMAND_START=["","/"]
PETPET_RESOURCE_URL=https://raw.githubusercontent.com/noneplugin/nonebot-plugin-petpet/v0.3.x/resources
API_TIMEOUT=120

# 签到与积分系统（SQLite 数据库由程序自动创建）
ECONOMY_DB_PATH=data/economy/qqbot.sqlite3
CHECKIN_REWARD_MIN=10
CHECKIN_REWARD_MAX=30
ROBBERY_COOLDOWN_SECONDS=600
RED_PACKET_TTL_SECONDS=86400
ROULETTE_COOLDOWN_SECONDS=60
ROULETTE_MAX_WAGER=1000
CULTIVATION_COOLDOWN_SECONDS=60

# 图片、视频与解析功能
MEDIA_ROOT=data/media
MEDIA_MAX_DOWNLOAD_MB=50
# 在 https://saucenao.com/ 注册后获取；未配置时“图片来源”会提示管理员配置。
SAUCENAO_API_KEY=

# 信息查询功能。60s API 免费但公共实例有额度限制，生产环境可改为自建地址。
INFO_60S_API_BASE_URL=https://60s.viki.moe/v2
# 官方主域名不可达时依次尝试；均来自 60s API 文档的公共实例列表。
INFO_60S_API_FALLBACK_URLS=https://60s.crystelf.top/v2,https://60s.7se.cn/v2
INFO_API_TIMEOUT_SECONDS=20
HOT_SEARCH_LIMIT=10

# TMDB API Read Access Token：在 https://www.themoviedb.org/settings/api 申请。
# 与 DeepSeek API Key 不通用；未配置时“影视搜索”会返回配置提示。
TMDB_ACCESS_TOKEN=
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# MangaDex 公开检索接口，不需要密钥；保留该项便于切换反向代理或测试地址。
MANGADEX_API_BASE_URL=https://api.mangadex.org

# 批次六：语音与词云。Edge 在线语音无需 Key，但合成文本会发送给微软服务。
TTS_MAX_CHARACTERS=300
TTS_TIMEOUT_SECONDS=45
# Windows 可填 C:/Windows/Fonts/msyh.ttc；Docker 留空会自动寻找 Noto CJK。
WORDCLOUD_FONT_PATH=
WORDCLOUD_RETENTION_DAYS=30

# RSS/B站订阅轮询。RSS 无需密钥；B站公开网页接口可能要求已登录账号的 SESSDATA。
RSS_POLL_SECONDS=300
BILI_POLL_SECONDS=180
BILIBILI_API_BASE_URL=https://api.bilibili.com
BILIBILI_LIVE_API_BASE_URL=https://api.live.bilibili.com
# 仅写 Cookie 中 SESSDATA 的值；不要提交 Git，也不要发到群聊。
BILIBILI_SESSDATA=
