# NoneBot 服务端配置
HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi
LOG_LEVEL=INFO
COMMAND_START=["/"]

# 若协议端配置了 Access Token，这里必须填写相同的值。
# 本机首次调试可以两端都留空；公网/局域网监听时务必使用强随机 Token。
ONEBOT_ACCESS_TOKEN=

# 群管理：默认关闭自动撤回，确认机器人有管理员权限后再开启。
ENABLE_SENSITIVE_RECALL=false
SENSITIVE_WORDS=广告

# DeepSeek API（密钥仅填写在本机 .env.prod，不要提交到 Git）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 头像表情包：同时支持“摸摸”和“/摸摸”等形式。
PETPET_COMMAND_START=["","/"]
PETPET_RESOURCE_URL=https://raw.githubusercontent.com/noneplugin/nonebot-plugin-petpet/v0.3.x/resources
API_TIMEOUT=120

